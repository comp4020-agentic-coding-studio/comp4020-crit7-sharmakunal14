---
import { listCoursesWithSessions, listSelectedSessions } from "../lib/db";
import { DAYS } from "../lib/schema";
import "../styles.css";

const courses = listCoursesWithSessions();
const selected = listSelectedSessions();

const HOURS = Array.from({ length: 8 }, (_, i) => i + 9); // 9am .. 4pm start

const error = Astro.url.searchParams.get("error");
const clashWith = Astro.url.searchParams.get("with");

function cellSession(day: string, hour: number) {
  return selected.find((s) => s.day === day && s.startHour <= hour && hour < s.endHour);
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Timetable — COMP4020 prototype</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My Timetable</h1>
      <p>
        A slice of ANU's MyTimetable: pick one session per course from a
        fixed set of options. Picking a session that overlaps a session
        you've already chosen for another course is rejected; picking a new
        one for a course you've already chosen replaces the old pick.
      </p>

      {
        error === "clash" && (
          <p role="alert" class="error">
            That session clashes with your {clashWith} session — pick another
            time.
          </p>
        )
      }

      <section aria-labelledby="courses-heading">
        <h2 id="courses-heading">Courses</h2>
        {
          courses.map((course) => (
            <article>
              <h3>
                {course.code} — {course.name}
              </h3>
              <ul class="options">
                {course.options.map((option) => {
                  const isSelected = option.id === course.selectedSessionId;
                  return (
                    <li>
                      <form method="post" action="/api/select">
                        <input type="hidden" name="sessionId" value={option.id} />
                        <button aria-pressed={isSelected} disabled={isSelected}>
                          {isSelected ? "✓ " : ""}
                          {option.label}: {option.day} {option.startHour}:00–
                          {option.endHour}:00, {option.location}
                        </button>
                      </form>
                    </li>
                  );
                })}
              </ul>
            </article>
          ))
        }
      </section>

      <section aria-labelledby="grid-heading">
        <h2 id="grid-heading">Your week</h2>
        <table id="timetable-grid">
          <thead>
            <tr>
              <th scope="col">Time</th>
              {DAYS.map((day) => <th scope="col">{day}</th>)}
            </tr>
          </thead>
          <tbody>
            {HOURS.map((hour) => (
              <tr>
                <th scope="row">{hour}:00</th>
                {DAYS.map((day) => {
                  const session = cellSession(day, hour);
                  return (
                    <td>
                      {session && session.startHour === hour ? (
                        <span>
                          {session.course.code}
                          <br />
                          {session.label}
                        </span>
                      ) : (
                        session ? "" : "—"
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </main>
    <script>
      // Another tab picked a session: the simplest correct thing is to
      // re-render from the database, since a selection can move or replace
      // cells anywhere in the grid.
      const source = new EventSource("/api/events");
      source.addEventListener("message", () => {
        location.reload();
      });
    </script>
  </body>
</html>
